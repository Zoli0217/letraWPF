<Window x:Class="letraWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:letraWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <StackPanel>
            <Label Content="Játékos neve:"/>
            <TextBox Name="playerNameTb" Width="200" Margin="0,0,0,10"/>
            <Slider Minimum="0" Maximum="255" x:Name="redSli" Margin="5,5,5,5" ValueChanged="Sli_ValueChanged"/>
            <Slider Minimum="0" Maximum="255" x:Name="greenSli" Margin="5,5,5,5" ValueChanged="Sli_ValueChanged"/>
            <Slider Minimum="0" Maximum="255" x:Name="blueSli" Margin="5,5,5,5" ValueChanged="Sli_ValueChanged"/>
            <Ellipse Width="100" Height="100" Fill="Black" Margin="0,10,0,10" x:Name="colorEll"/>
            <Button Content="Regisztráció" Click="regBtn" Margin="5,0,5,0"/>
            <ListBox Height="140px" Margin="5,10,5,0" x:Name="jatekosLb"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
            <Label Content="Játék" FontWeight="bold" FontSize="20px" HorizontalAlignment="Center"/>
            <Label Content="Játékos: " FontWeight="bold" FontSize="15px" x:Name="jatekosNeve"></Label>
            <TextBlock Text="Eredmény:" Margin="5px"><Label x:Name="eredmenyLb"/></TextBlock>
            <Button Content="Dobás" Margin="5,0,5,0" Click="Button_Click"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
            <ListBox x:Name="Output" Height="200px" Margin="5"></ListBox>
        </StackPanel>
    </Grid>
</Window>
